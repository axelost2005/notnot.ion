# Copiá este archivo a .env (en la raíz) y completá los valores. El .env nunca se commitea.

# Neon: connection string pooled (con "-pooler" en el host). La usa la app en runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon: connection string directa (sin "-pooler"). La usa el CLI de Prisma para migrar.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Código del candado: una frase de 4 o más palabras al azar.
APP_SECRET="cuatro palabras al azar"

# Firma la cookie de sesión (32+ caracteres). Rotarlo cierra todas las sesiones.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiame-por-algo-largo-y-al-azar-de-32-o-mas"
