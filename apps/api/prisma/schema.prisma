generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  slug       String    @unique
  color      String
  position   String
  isGeneral  Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  columns     Column[]
  tasks       Task[]
  notes       Note[]
  payments    Payment[]
  receivables Receivable[]
}

model Column {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  position  String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  // Lo usa la FK compuesta de Task: la columna de una tarea siempre es de su mismo tablero.
  @@unique([id, boardId])
  @@index([boardId])
}

model Task {
  id          String    @id @default(uuid(7)) @db.Uuid
  boardId     String    @db.Uuid
  columnId    String    @db.Uuid
  title       String
  description String?
  position    String
  completedAt DateTime?
  // Terminada antes de hoy: ya no se ve en el tablero, está en el historial.
  archivedAt  DateTime?
  noteId      String?   @db.Uuid
  noteLine    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board  Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // NoAction (y no Restrict) para que el borrado en cascada del tablero no choque con esta FK.
  column Column  @relation(fields: [columnId, boardId], references: [id, boardId], onDelete: NoAction)
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  images Image[]

  @@index([boardId])
  @@index([columnId, position])
  @@index([noteId])
  @@index([archivedAt, completedAt])
}

model Note {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, createdAt])
}

/// Imagen privada en Vercel Blob, de una tarea o de un pago (nunca de los dos: lo exige un CHECK de
/// la migración). Borrar la fila no borra el archivo: lo hace la API.
model Image {
  id          String   @id @default(uuid(7)) @db.Uuid
  taskId      String?  @db.Uuid
  paymentId   String?  @db.Uuid
  pathname    String   @unique
  contentType String
  size        Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([paymentId, createdAt])
}

/// Carpeta de la sección Notas (aparte de las notas de los tableros). Puede tener carpetas adentro.
model Folder {
  id        String   @id @default(uuid(7)) @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Borrar una carpeta borra lo que tiene adentro.
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  pages    Page[]

  @@index([parentId])
}

/// Nota de la sección Notas: título y texto. Suelta en la raíz o dentro de una carpeta.
model Page {
  id        String   @id @default(uuid(7)) @db.Uuid
  folderId  String?  @db.Uuid
  title     String   @default("")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

/// Un pago que me hicieron (Finanzas). Solo ingresos, en ARS o USD.
model Payment {
  id           String   @id @default(uuid(7)) @db.Uuid
  date         DateTime @db.Date
  amountCents  BigInt
  currency     String
  // El cliente es un tablero. Si se borra el tablero, el pago queda sin cliente.
  boardId      String?  @db.Uuid
  category     String?
  description  String?
  // Lo que me debían y este pago cubre (o parte). Si se borra, el pago queda suelto.
  receivableId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  board      Board?      @relation(fields: [boardId], references: [id], onDelete: SetNull)
  receivable Receivable? @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  images     Image[]

  @@index([date])
  @@index([boardId])
  @@index([receivableId])
}

/// Algo que me deben (Finanzas → Por cobrar). Lo cobrado son los pagos que apuntan acá, en la misma
/// moneda (lo controla la API).
model Receivable {
  id          String    @id @default(uuid(7)) @db.Uuid
  description String
  amountCents BigInt
  currency    String
  // El cliente es un tablero. Si se borra el tablero, queda sin cliente.
  boardId     String?   @db.Uuid
  // El día que me lo tienen que pagar.
  dueDate     DateTime? @db.Date
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board    Board?    @relation(fields: [boardId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([boardId])
}
